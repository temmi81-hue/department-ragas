OPENAI_API_KEY=sk-your-key-here
RAG_TOP_K=6
# 답변 생성 모델. 기본값은 코드(app/api/rag/route.ts)에서 'gpt-5.6-luna'로 설정되어 있어
# 이 줄을 지워도 동작합니다. gpt-4o-mini 등으로 되돌리려면 아래 주석을 풀어 값을 바꾸세요.
# RAG_CHAT_MODEL=gpt-4o-mini

# --- LangSmith (선택) ---
# 3차 개발: /api/rag 호출을 LangSmith에 트레이싱해서 검색 근거·최종 답변을 확인합니다.
# 아래 값이 없으면 langsmith SDK가 아무 것도 전송하지 않고 조용히 통과하므로
# 로컬 개발/발표 데모에는 영향이 없습니다. 키는 https://smith.langchain.com 에서 발급받습니다.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=department-ragas
